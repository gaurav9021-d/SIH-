# NASA FIRMS (request a free key at https://firms.modaps.eosdis.nasa.gov/api/area/)
FIRMS_MAP_KEY=replace-with-your-firms-map-key
# MAP_KEY is accepted as a legacy alias, but FIRMS_MAP_KEY takes precedence.

# Local PostGIS
POSTGRES_USER=sih
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=sih
DATABASE_URL=postgresql+psycopg://sih:replace-with-a-local-password@127.0.0.1:5432/sih

# Optional configuration overrides
INGEST_CONFIG=ingestion/config/ingestion.yaml
# INGEST__DATABASE__POOL_SIZE=2
# INGEST__FIRMS__BACKFILL__TRANSACTIONS_PER_10_MINUTES=3000
